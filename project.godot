; Engine configuration file.
; Edit through the Godot editor (Project > Project Settings) where possible.

config_version=5

[application]

config/name="LumoraRPG"
config/description="3D pixel-art roguelike survivor."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[display]

; The UI is laid out at 1280x720 and scales smoothly with the window (sharp text).
; The 3D world renders at half resolution inside a SubViewport for the pixel look (see main.gd).
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; Item stats show right away when hovering an item.
timers/tooltip_delay_sec=0.05

[rendering]

; Browsers only support the Compatibility renderer.
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
